<section class="codex-foundry-root codex-sheet {{#if codex.editing}}is-edit-mode{{else}}is-play-mode{{/if}}">
  <header class="codex-hero">
    <div class="codex-portrait-column">
      <div class="codex-portrait {{#if codex.defaultPortrait}}is-placeholder{{/if}}"><img src="{{codex.portrait}}" alt="Retrato de {{codex.actorName}}"></div>
      {{#if codex.editing}}
      <button class="codex-edit-portrait" type="button" data-action="editPortrait"><i class="fa-solid fa-image" aria-hidden="true"></i> Alterar retrato</button>
      {{/if}}
    </div>
    <div class="codex-identity">
      <div class="codex-brand">
        <div>
          <span class="codex-overline">{{codex.actorTypeLabel}}{{#if codex.sheetLocation}} · {{codex.sheetLocation}}{{/if}}</span>
          {{#if codex.editing}}<label class="codex-hero-name">Nome do personagem<input type="text" value="{{codex.actorName}}" data-field="name"></label>{{else}}<h2>{{codex.actorName}}</h2>{{/if}}
        </div>
        {{#if codex.isOwner}}<button type="button" class="codex-mode-toggle" data-action="toggleEditing" {{#if codex.hasPending}}disabled{{/if}} aria-pressed="{{#if codex.editing}}true{{else}}false{{/if}}">{{#if codex.editing}}Concluir edição · Jogar{{else}}Editar ficha{{/if}}</button>{{/if}}
      </div>
      <div class="codex-identity-fields">
        <label>Conceito / profissão <input type="text" value="{{codex.concept}}" data-field="system.concept" {{#unless codex.editing}}readonly{{/unless}}></label>
        {{#if codex.isHostile}}
          <label>Grau <input type="number" min="1" max="6" value="{{codex.threatGrade}}" data-field="system.threatGrade" {{#unless codex.editing}}readonly{{/unless}}></label>
        {{else}}
          <label>Nível <input type="number" min="1" max="20" value="{{codex.level}}" data-field="system.level" {{#unless codex.editing}}readonly{{/unless}}></label>
        {{/if}}
        {{#if codex.editing}}
        <label>Origem narrativa<input type="text" value="{{codex.origin}}" data-field="system.origin">{{#if codex.race}}<small>{{codex.race}}</small>{{/if}}</label>
        {{else}}
        <div class="codex-origin-display">
          <span>{{#if codex.race}}Linhagem{{else}}Origem narrativa{{/if}}</span>
          <strong>{{#if codex.race}}{{codex.race}}{{else}}{{#if codex.origin}}{{codex.origin}}{{else}}—{{/if}}{{/if}}</strong>
          {{#if codex.race}}{{#if codex.origin}}<small>{{codex.origin}}</small>{{/if}}{{/if}}
        </div>
        {{/if}}
      </div>
      <details data-sync="identity" class="codex-identity-details" {{#if codex.identityOpen}}open{{/if}}>
        <summary>Virtude e personalidade</summary>
        <div class="codex-identity-fields">
          <label>Virtude <input type="text" value="{{codex.virtue}}" data-field="system.virtue" {{#unless codex.editing}}readonly{{/unless}}></label>
          <label>Personalidade <input type="text" value="{{codex.personality}}" data-field="system.personality" {{#unless codex.editing}}readonly{{/unless}}></label>
        </div>
      </details>
    </div>
  </header>

  <div class="codex-vitals" aria-label="Recursos do personagem">
    <div class="codex-vital-row">
      <button type="button" class="codex-vital codex-vital-primary" data-action="resourceDetails" data-vital="life" aria-expanded="false" aria-controls="{{codex.appId}}-vital-life" aria-label="Vida {{codex.life}} / {{codex.lifeMax}}"><img src="systems/codex-rpg-foundry/assets/icons/codex/status-vida.svg" alt=""><strong>{{codex.life}} / {{codex.lifeMax}}</strong></button>
      <button type="button" class="codex-vital codex-vital-primary" data-action="resourceDetails" data-vital="integrity" aria-expanded="false" aria-controls="{{codex.appId}}-vital-integrity" aria-label="Integridade {{#if codex.armorCard}}{{#if codex.armorCard.hasMaximum}}{{codex.armorCard.integrity}} / {{codex.armorCard.maximum}}{{else}}—{{/if}}{{else}}—{{/if}}"><img src="systems/codex-rpg-foundry/assets/icons/codex/status-integridade.svg" alt=""><strong>{{#if codex.armorCard}}{{#if codex.armorCard.hasMaximum}}{{codex.armorCard.integrity}} / {{codex.armorCard.maximum}}{{else}}—{{/if}}{{else}}—{{/if}}</strong></button>
      <button type="button" class="codex-vital codex-vital-primary" data-action="resourceDetails" data-vital="defense" aria-expanded="false" aria-controls="{{codex.appId}}-vital-defense" aria-label="DE defensiva {{codex.de}}"><img src="systems/codex-rpg-foundry/assets/icons/codex/status-de.svg" alt=""><strong>{{codex.de}}</strong></button>
      <button type="button" class="codex-vital codex-vital-primary" data-action="resourceDetails" data-vital="movement" aria-expanded="false" aria-controls="{{codex.appId}}-vital-movement" aria-label="Deslocamento {{codex.movement}} m"><img src="systems/codex-rpg-foundry/assets/icons/codex/status-movimento.svg" alt=""><strong>{{codex.movement}} m</strong></button>
      {{#unless codex.attributesOnly}}
      <button type="button" class="codex-vital " data-action="resourceDetails" data-vital="courage" aria-expanded="false" aria-controls="{{codex.appId}}-vital-courage" aria-label="Coragem {{codex.courage}} / {{codex.courageMax}}"><img src="systems/codex-rpg-foundry/assets/icons/codex/status-coragem.svg" alt=""><strong>{{codex.courage}} / {{codex.courageMax}}</strong></button>
      {{/unless}}
      {{#if codex.isHostile}}
      <button type="button" class="codex-vital codex-vital-pavor" data-action="resourceDetails" data-vital="pavor" aria-expanded="false" aria-controls="{{codex.appId}}-vital-pavor" aria-label="Pavor local {{codex.pavorLocal}} de {{codex.pavorCap}}"><span aria-hidden="true">ᚦ</span><strong>{{codex.pavorLocal}} / {{codex.pavorCap}}</strong></button>
      {{/if}}
      <button type="button" class="codex-vital codex-vital-load {{#if codex.overloaded}}is-overloaded{{/if}}" data-action="resourceDetails" data-vital="load" aria-expanded="false" aria-controls="{{codex.appId}}-vital-load" aria-label="Balanço e carga {{codex.balance}}"><img src="systems/codex-rpg-foundry/assets/icons/codex/status-balanco.svg" alt=""><strong>{{codex.balance}}</strong></button>
      <button type="button" class="codex-vital codex-vital-inventory" data-action="sheetPage" data-page="inventory" aria-label="Abrir Inventário"><img src="systems/codex-rpg-foundry/assets/icons/codex/status-inventario.svg" alt=""><span>Inventário</span></button>
    </div>
    <section id="{{codex.appId}}-vital-life" class="codex-vital-detail" data-vital-panel="life" hidden>
      <h3>Vida</h3>
      <p>{{codex.life}} / {{codex.lifeMax}} · {{codex.health.label}}{{#if codex.healthApplied}}{{#if codex.health.coragem}} · {{codex.health.coragem}} Coragem por ação{{/if}}{{/if}}</p>
      {{#if codex.isOwner}}
        <div class="codex-step"><button type="button" data-action="adjustResource" data-resource="system.life.value" data-delta="-1" aria-label="Retirar 1 Vida">−</button><button type="button" data-action="adjustResource" data-resource="system.life.value" data-delta="1" aria-label="Recuperar 1 Vida">+</button></div>
      {{/if}}
    </section>
    <section id="{{codex.appId}}-vital-integrity" class="codex-vital-detail" data-vital-panel="integrity" hidden>
      <h3>Integridade</h3>
      {{#if codex.armorCard}}
      <p>{{codex.armorCard.name}} · {{#if codex.armorCard.hasMaximum}}{{codex.armorCard.integrity}} / {{codex.armorCard.maximum}}{{else}}Integridade máxima não definida{{/if}}</p>
      {{#if codex.armorCard.hasMaximum}}
        <meter min="0" max="{{codex.armorCard.maximum}}" value="{{codex.armorCard.integrity}}" aria-label="Integridade da armadura"></meter>
        {{#if codex.isOwner}}<div class="codex-step">
          <button type="button" data-action="adjustIntegrity" data-id="{{codex.armorCard.id}}" data-delta="-1" aria-label="Reduzir Integridade">−</button>
          <button type="button" data-action="adjustIntegrity" data-id="{{codex.armorCard.id}}" data-delta="1" aria-label="Recuperar Integridade">+</button>
        </div>{{/if}}
      {{else}}
        {{#if codex.editing}}<button type="button" data-action="openEquipment" data-id="{{codex.armorCard.id}}">Configurar equipamento</button>{{/if}}
      {{/if}}
      {{else}}<p>Sem armadura equipada.</p>{{/if}}
    </section>
    <section id="{{codex.appId}}-vital-defense" class="codex-vital-detail" data-vital-panel="defense" hidden>
      <h3>DE defensiva</h3>
      <p>{{codex.deCalculation}}</p>
      <p>{{codex.deCondition}}</p>
    </section>
    <section id="{{codex.appId}}-vital-movement" class="codex-vital-detail" data-vital-panel="movement" hidden>
      <h3>Deslocamento</h3>
      <p><strong>{{codex.movement}} m</strong> · 8 m + Agilidade + Atletismo ÷ 3 (graus completos)</p>
    </section>
    {{#unless codex.attributesOnly}}
    <section id="{{codex.appId}}-vital-courage" class="codex-vital-detail" data-vital-panel="courage" hidden>
      <h3>Coragem</h3>
      <p>{{codex.courage}} / {{codex.courageMax}}</p>
      {{#if codex.isOwner}}
        <div class="codex-step"><button type="button" data-action="adjustResource" data-resource="system.courage" data-delta="-1" aria-label="Retirar 1 Coragem">−</button><button type="button" data-action="adjustResource" data-resource="system.courage" data-delta="1" aria-label="Recuperar 1 Coragem">+</button></div>
      <div class="codex-actions"><button type="button" data-action="rest" data-kind="short">Descanso curto</button><button type="button" data-action="rest" data-kind="long">Descanso longo</button></div>
      {{#if codex.hasDruidic}}<button type="button" data-action="transform">{{#if codex.transformed}}Reverter forma{{else}}Transformação Druídica{{/if}}</button>{{/if}}
      {{/if}}
    </section>
    {{/unless}}
    {{#if codex.isHostile}}
    <section id="{{codex.appId}}-vital-pavor" class="codex-vital-detail" data-vital-panel="pavor" hidden>
      <h3>Pavor local</h3>
      <p>{{codex.pavorLocal}} / {{codex.pavorCap}}</p>
      {{#if codex.isMonster}}<p>Ativação ofensiva em combate custa 1P.</p>{{/if}}
      {{#if codex.isGM}}<div class="codex-step">
        <button type="button" data-action="adjustPavor" data-delta="-1" aria-label="Retirar 1 Pavor">−</button>
        <button type="button" data-action="adjustPavor" data-delta="1" aria-label="Adicionar 1 Pavor">+</button>
      </div>{{/if}}
    </section>
    {{/if}}
    <section id="{{codex.appId}}-vital-load" class="codex-vital-detail" data-vital-panel="load" hidden>
      <h3>Balanço e carga</h3>
      <p>{{codex.balance}} · {{codex.loadUsed}} / {{codex.capacity}} Alto</p>
      <p>Espaço restante: {{codex.loadFree}} Alto · {{codex.carryClasses.leve}} Leves · {{codex.carryClasses.medio}} Médios · {{codex.carryClasses.pesado}} Pesados</p>
      {{#if codex.overloaded}}<p class="codex-warning">Sobrecarga anotada.</p>{{/if}}
    </section>
  </div>

  <nav class="codex-sheet-tabs" aria-label="Áreas da ficha">
    {{#each codex.pages}}
    <button type="button" data-action="sheetPage" data-page="{{id}}" aria-controls="{{@root.codex.appId}}-page-{{id}}"><strong>{{label}}</strong><small>{{description}}</small></button>
    {{/each}}
  </nav>
  {{#if codex.hasPending}}<button type="button" class="codex-resume-roll" data-action="showRoll">Retomar rolagem</button>{{/if}}

  <section id="{{codex.appId}}-page-evolution" class="codex-block codex-evolution" data-sheet-panel="evolution" aria-label="Evolução" hidden>
    <h2>Evolução</h2>
    {{#if codex.historicalBard}}
    <details data-sync="bard-history" class="codex-bard-history">
      <summary>Histórico do Bardo para revisão</summary>
      <p>Os registros abaixo foram preservados. Consulte os efeitos na Maestria em Apresentação.</p>
      <ul>{{#each codex.historicalBard}}<li>{{this}}</li>{{/each}}</ul>
    </details>
    {{/if}}
    <dl class="codex-stat-cards">
      <div><dt>XP disponíveis</dt><dd>{{codex.xpLedger.left}}</dd></div>
      <div><dt>XP investidos</dt><dd>{{codex.xpLedger.spent}}</dd></div>
      <div><dt>XP totais</dt><dd>{{codex.xpLedger.grant}}</dd></div>
    </dl>
    <div class="codex-actions">
      {{#if codex.canOpenDNA}}<button type="button" data-action="sheetPage" data-page="genetic">Ver Perícias no Codex Genético</button>{{/if}}
      <button type="button" data-action="sheetPage" data-page="play">Ver fontes na ficha</button>
    </div>

  {{#if codex.editing}}
  <details data-sync="progress" class="codex-creation-panel" {{#if codex.progressOpen}}open{{/if}}>
    <summary>
      <strong>Progressão</strong>
      <span>{{codex.xpLedger.left}} XP disponíveis · {{codex.xpLedger.spent}} / {{codex.xpLedger.grant}} gastos</span>
    </summary>
    <label>{{#if codex.attributesOnly}}Orçamento de XP{{else}}XP adicional{{/if}}
      <input type="number" min="0" value="{{codex.xp}}" data-field="system.xp" {{#unless codex.canAdjustXP}}readonly{{/unless}}>
    </label>
     {{#unless codex.attributesOnly}}{{#unless codex.hasCreationMinimum}}
       <details class="codex-starter-guide" open>
        <summary>Compras mínimas orientadas</summary>
        <p>Escolha um Atributo e um Conhecimento ou Prática. O custo segue as tabelas da origem.</p>
        <div class="codex-starter-fields">
         <label>Atributo inicial<select data-starter-attr>{{#each codex.starterAttributes}}
          <option value="{{this.id}}">{{this.name}}</option>{{/each}}</select></label>
         <label>Conhecimento ou Prática inicial<select data-starter-training>{{#each codex.starterTraining}}
          <option value="{{this.value}}">{{this.name}}</option>{{/each}}</select></label>
         <button type="button" class="codex-primary" data-action="purchaseStarter">Confirmar compras mínimas</button>
        </div>
        <small>Somente compras ainda não realizadas custam XP; requisitos mínimos são verificados antes de confirmar.</small>
       </details>
     {{/unless}}{{/unless}}
  </details>
  {{/if}}
  </section>

  {{#if codex.canOpenDNA}}
  <section id="{{codex.appId}}-page-genetic" data-sheet-panel="genetic" aria-label="Codex Genético" hidden>
    <div data-genetic-host></div>
  </section>
  {{/if}}

  <section id="{{codex.appId}}-page-play" data-sheet-panel="play" aria-label="Jogar">
  <div class="codex-help codex-play-guide">
    <strong>{{#if codex.editing}}Editar personagem{{else}}Componha a ação pela ficha{{/if}}</strong>
    {{#if codex.editing}}<span>Use −/+ para comprar ou ajustar graus. Clique em <b>Concluir edição · Jogar</b> quando terminar.</span>{{else}}{{#if codex.attributesOnly}}<span><b>1.</b> Escolha um Atributo. <b>2.</b> Escolha outro Atributo.</span>{{else}}<span>Escolha duas fontes de categorias diferentes, em qualquer ordem. Clique no cartão novamente para retirar a fonte.</span>{{/if}}{{/if}}

  </div>

  {{#unless codex.editing}}
    <div class="codex-actions codex-action-bar">
      {{#if codex.canAttack}}<button type="button" class="codex-primary" data-action="prepareAction" data-kind="attack">Atacar</button>{{/if}}
      {{#if codex.canCast}}<button type="button" class="codex-primary" data-action="prepareAction" data-kind="spell">Conjurar</button>{{/if}}
      {{#if codex.lightHands}}<button type="button" data-action="lightHands">Mãos Leves</button>{{/if}}
      {{#if codex.canAttack}}{{#each codex.equipment.shortcuts}}
        <button type="button" data-action="prepareEquipment" data-id="{{id}}" {{#unless enabledDie}}disabled{{/unless}}>{{{icon}}} {{name}}</button>
      {{/each}}{{/if}}
      {{#unless codex.hasPending}}{{#if codex.preparing}}<button type="button" data-action="showRoll">Ver rolagem</button>{{/if}}{{/unless}}
    </div>
  {{/unless}}
  {{#with codex.sphere}}
  <details class="codex-help" data-sync="spiritual-spheres">
    <summary>Esferas Espirituais · {{count}}/5</summary>
    <p>{{createdThisRound}}/5 criadas nesta rodada. {{#if ready}}Punho Supremo de Asura disponível em Atacar.{{/if}}</p>
    <div class="codex-actions">
      <button type="button" data-action="sphere" data-kind="create" {{#unless canCreate}}disabled{{/unless}}>Criar esfera (−1 Coragem)</button>
      {{#if manualRound}}<button type="button" data-action="sphere" data-kind="nextRound" {{#unless createdThisRound}}disabled{{/unless}}>Confirmar próxima rodada</button>{{/if}}
      {{#if count}}
        {{#if absorb}}<button type="button" data-action="sphere" data-kind="absorb">Absorver todas</button>{{/if}}
        {{#if step}}<button type="button" data-action="sphere" data-kind="passo-etereo" title="Registre o movimento de até 8 m na mesa">Passo Etéreo (−1 esfera)</button>{{/if}}
        {{#if ranged}}<button type="button" data-action="sphere" data-kind="disparo-esferas-espirituais" title="Resolva o disparo físico na mesa">Declarar disparo (−1 esfera)</button>{{/if}}
      {{/if}}
    </div>
  </details>
  {{/with}}
  <div class="codex-rune-legend" role="note" aria-label="Símbolos oficiais do Codex RPG">
    <span class="legend-e"><b aria-hidden="true">ᛋ</b> Êxito</span>
    <span class="legend-a"><b aria-hidden="true">ᚨ</b> Antecipar</span>
    <span class="legend-p"><b aria-hidden="true">ᚦ</b> Pavor</span>
  </div>

  <div class="codex-source-layout {{#if codex.attributesOnly}}is-attributes-only{{/if}}">
    <section class="codex-block codex-attributes">
      <div class="codex-block-title"><h2>Atributos</h2></div>
      {{#each codex.attributes}}
        <div class="codex-source {{#if @root.codex.editing}}is-editing{{else}}is-playing{{/if}} {{#if this.isSecond}}is-attribute{{/if}} {{#if this.isBase}}is-base{{/if}} {{#if this.isComplement}}is-complement{{/if}}">
          {{#if @root.codex.editing}}
          <div class="codex-source-static"><strong class="codex-source-name">{{this.label}}</strong>{{#if this.xpLabel}}<small>{{this.xpLabel}}</small>{{/if}}<span class="codex-dice-strip">{{#each this.dice}}<span class="codex-small-die" title="d{{this.sides}}">{{{this.icon}}}<b>d{{this.sides}}</b></span>{{/each}}</span></div>
          <div class="codex-grade"><button type="button" data-action="adjustGrade" data-grade="{{this.grade}}" data-group="{{this.group}}" data-key="{{this.key}}" data-delta="-1">−</button><b>{{this.grade}}</b><button type="button" data-action="adjustGrade" data-grade="{{this.grade}}" data-group="{{this.group}}" data-key="{{this.key}}" data-delta="1">+</button></div>
          {{else}}
          <button type="button" class="codex-source-pick" data-action="chooseSource" data-group="{{this.group}}" data-key="{{this.key}}" aria-pressed="{{#if this.isSelected}}true{{else}}false{{/if}}">
            <span class="codex-source-name">{{this.label}}</span>
             <span class="codex-source-order" aria-hidden="true">{{#if this.isBase}}1ª{{else}}{{#if this.isSecond}}2ª{{else}}{{#if this.isComplement}}3ª{{/if}}{{/if}}{{/if}}</span>
            <span class="codex-dice-strip">{{#each this.dice}}<span class="codex-small-die" title="d{{this.sides}}">{{{this.icon}}}<b>d{{this.sides}}</b></span>{{/each}}</span>
          <span class="codex-source-grade-tag">G{{this.grade}}</span>
           </button>
          {{/if}}
        </div>
      {{/each}}
    </section>

    {{#unless codex.attributesOnly}}
    <section class="codex-block">
      <div class="codex-block-title"><h2>Práticas</h2></div>
      {{#each codex.practices}}
        <div class="codex-source {{#if @root.codex.editing}}is-editing{{else}}is-playing{{/if}} {{#if this.isSecond}}is-attribute{{/if}} {{#if this.isBase}}is-base{{/if}} {{#if this.isComplement}}is-complement{{/if}}">
          {{#if @root.codex.editing}}
          <div class="codex-source-static"><strong class="codex-source-name">{{this.label}}</strong>{{#if this.xpLabel}}<small>{{this.xpLabel}}</small>{{/if}}<span class="codex-dice-strip">{{#each this.dice}}<span class="codex-small-die" title="d{{this.sides}}">{{{this.icon}}}<b>d{{this.sides}}</b></span>{{/each}}</span></div>
          <div class="codex-grade"><button type="button" data-action="adjustGrade" data-grade="{{this.grade}}" data-group="{{this.group}}" data-key="{{this.key}}" data-delta="-1">−</button><b>{{this.grade}}</b><button type="button" data-action="adjustGrade" data-grade="{{this.grade}}" data-group="{{this.group}}" data-key="{{this.key}}" data-delta="1">+</button></div>
          {{else}}
          <button type="button" class="codex-source-pick" data-action="chooseSource" data-group="{{this.group}}" data-key="{{this.key}}" aria-pressed="{{#if this.isSelected}}true{{else}}false{{/if}}">
            <span class="codex-source-name">{{this.label}}</span>
             <span class="codex-source-order" aria-hidden="true">{{#if this.isBase}}1ª{{else}}{{#if this.isSecond}}2ª{{else}}{{#if this.isComplement}}3ª{{/if}}{{/if}}{{/if}}</span>
            <span class="codex-dice-strip">{{#each this.dice}}<span class="codex-small-die" title="d{{this.sides}}">{{{this.icon}}}<b>d{{this.sides}}</b></span>{{/each}}</span>
          <span class="codex-source-grade-tag">G{{this.grade}}</span>
           </button>
          {{/if}}
        </div>
      {{/each}}
    </section>
    <section class="codex-block">
      <div class="codex-block-title"><h2>Conhecimentos</h2></div>
      {{#each codex.knowledges}}
        <div class="codex-source {{#if @root.codex.editing}}is-editing{{else}}is-playing{{/if}} {{#if this.isSecond}}is-attribute{{/if}} {{#if this.isBase}}is-base{{/if}} {{#if this.isComplement}}is-complement{{/if}}">
          {{#if @root.codex.editing}}
          <div class="codex-source-static"><strong class="codex-source-name">{{this.label}}</strong><span class="codex-dice-strip">{{#each this.dice}}<span class="codex-small-die" title="d{{this.sides}}">{{{this.icon}}}<b>d{{this.sides}}</b></span>{{/each}}</span></div>
          <div class="codex-grade"><button type="button" data-action="adjustGrade" data-grade="{{this.grade}}" data-group="{{this.group}}" data-key="{{this.key}}" data-delta="-1">−</button><b>{{this.grade}}</b><button type="button" data-action="adjustGrade" data-grade="{{this.grade}}" data-group="{{this.group}}" data-key="{{this.key}}" data-delta="1">+</button></div>
          {{else}}
          <button type="button" class="codex-source-pick" data-action="chooseSource" data-group="{{this.group}}" data-key="{{this.key}}" aria-pressed="{{#if this.isSelected}}true{{else}}false{{/if}}">
            <span class="codex-source-name">{{this.label}}</span>
             <span class="codex-source-order" aria-hidden="true">{{#if this.isBase}}1ª{{else}}{{#if this.isSecond}}2ª{{else}}{{#if this.isComplement}}3ª{{/if}}{{/if}}{{/if}}</span>
            <span class="codex-dice-strip">{{#each this.dice}}<span class="codex-small-die" title="d{{this.sides}}">{{{this.icon}}}<b>d{{this.sides}}</b></span>{{/each}}</span>
          <span class="codex-source-grade-tag">G{{this.grade}}</span>
           </button>
          {{/if}}
        </div>
      {{/each}}
    </section>

    {{/unless}}
  </div>

  {{#if codex.selectedBase}}
    <div class="codex-help" aria-live="polite">
      <span class="codex-live-note"><b>1ª fonte:</b> {{codex.selectedBase}}{{#if codex.selectedSecond}} · <b>2ª fonte:</b> {{codex.selectedSecond}}{{#if codex.selectedComplement}} · <b>Complemento:</b> {{codex.selectedComplement}}{{/if}}.{{else}}{{/if}}</span>
    </div>
  {{/if}}
  {{#if codex.hasPending}}
    <p class="codex-tip codex-source-pending-note">Use Retomar rolagem para finalizar ou descartar a ação pendente.</p>
  {{/if}}

  <div class="codex-roll-surface" aria-label="Rolagem Codex">
    <div class="codex-roll-popup-bar">
      <button type="button" class="codex-roll-drag" data-roll-drag aria-label="Mover janela de rolagem com as setas" title="Arraste para mover ou use as setas"><i class="fa-solid fa-grip-lines" aria-hidden="true"></i> Rolagem</button>
      <button type="button" data-action="closeRoll" aria-label="Fechar rolagem"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
    </div>
  {{#if codex.preparing}}
    <section class="codex-block codex-roll-prep" aria-label="Preparação da rolagem">
      <div class="codex-block-title"><h2>{{codex.prepare.actionLabel}}</h2></div>
      <div class="codex-compose">
        <div><small>BASE</small>{{#if codex.prepare.lockedDiscipline}}<strong>Disciplina</strong>{{else}}{{#if codex.prepare.fixedSources}}<strong>{{codex.prepare.baseName}}</strong>{{else}}
          <select data-roll-source="base" aria-label="Fonte base">{{#each codex.prepare.baseOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{/if}}{{/if}}</div>
        <div><small>{{#if codex.prepare.lockedDiscipline}}ATRIBUTO{{else}}2ª FONTE{{/if}}</small>
          {{#if codex.prepare.fixedSources}}<strong>{{codex.prepare.secondName}}</strong>{{else}}<select data-roll-source="second" aria-label="Segunda fonte">{{#each codex.prepare.secondOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{/if}}</div>
        {{#if codex.prepare.complementOptions.length}}<div><small>COMPLEMENTO</small>
          {{#if codex.prepare.repeatedDiscipline}}<strong>Disciplina</strong>{{else}}
          <select data-roll-source="complement" aria-label="Complemento"><option value="">Nenhum</option>{{#each codex.prepare.complementOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
          {{/if}}</div>{{/if}}
      </div>
      <p class="codex-tip">Atacante: <strong>{{codex.actorName}}</strong>{{#if codex.prepare.hasTarget}} · Alvo: <strong>{{codex.prepare.targetName}}</strong> · DE: <strong>{{codex.prepare.targetDE}}</strong>{{/if}}</p>
      <div class="codex-prep-controls">
       {{#if codex.prepare.modeArmas}}{{#unless codex.attributesOnly}}
       <label>Arma<select data-roll-option="equipmentId">
        <option value="">Mãos vazias</option>
        {{#each codex.prepare.equipmentOptions}}<option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>{{/each}}
       </select>{{#if codex.prepare.effectiveRange}}<small>Alcance efetivo {{codex.prepare.effectiveRange}} m</small>{{/if}}</label>
       {{/unless}}{{/if}}
       {{#if codex.prepare.casting}}
       <label>Elemento<select data-roll-option="element">{{#each codex.prepare.elements}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
       {{#if codex.prepare.magic.foci}}
       <label>Foco<select data-roll-option="focusId">
        <option value="">Sem foco</option>
        {{#each codex.prepare.magic.foci}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}} · {{charges}}/{{grade}} cargas</option>{{/each}}
       </select></label>
       {{/if}}
       <label>Grau da magia<select data-roll-option="magicGrade">{{#each codex.prepare.magic.grades}}<option value="{{value}}" {{#if selected}}selected{{/if}}>G{{value}}</option>{{/each}}</select></label>
       {{#with codex.prepare.magic}}
        {{#if maxCharges}}<label>Cargas para acelerar<input type="number" min="0" max="{{maxCharges}}" step="1" value="{{charges}}" data-roll-option="magicCharges"></label>{{/if}}
        {{#if hasFocus}}<label class="codex-check"><input type="checkbox" data-roll-option="magicAmplify" {{#if amplify}}checked{{/if}}> Amplificar com foco (+1 Coragem)</label>{{/if}}
        {{#if confirmGrade}}<label class="codex-check"><input type="checkbox" data-roll-option="magicGradeConfirmed" {{#if gradeConfirmed}}checked{{/if}}> Grau e efeito autorizados</label>{{/if}}
        {{#if showTime}}<label class="codex-check"><input type="checkbox" data-roll-option="magicTimeConfirmed" {{#if timeConfirmed}}checked{{/if}}> {{turns}} turnos de preparação cumpridos</label>{{/if}}
        {{#if wind}}<label>Trajetória de Ar em metros<input type="number" min="0" max="{{windRange}}" step="any" value="{{pathMeters}}" placeholder="Opcional" data-roll-option="magicPathMeters"><small>Até {{windRange}} m somando todos os trechos por passagem aberta.</small></label>{{/if}}
        {{#if canShield}}<label class="codex-check"><input type="checkbox" data-roll-option="runeShield" {{#if shield}}checked{{/if}}> Erguer Escudo Rúnico</label>{{/if}}
        {{#if courage}}<p>Conjuração · {{courage}} Coragem ao finalizar.</p>{{/if}}
        {{#if acid}}<details><summary>Ácido · Fogo + Veneno</summary><p>Registre a mistura na mesa e reserve 1A. {{#if mastery}}Em acerto, se aplicar Queimar junto ao efeito de Veneno, registre um acúmulo por 2 rodadas.{{else}}Improviso adapta o tipo de dano. Para aplicar ambos os efeitos, exige Maestria Elemental.{{/if}}</p></details>{{/if}}
       {{/with}}
       {{/if}}
       {{#if codex.prepare.stealthAvailable}}<label class="codex-check"><input type="checkbox" data-roll-option="stealthAttack" {{#if codex.prepare.stealthAttack}}checked{{/if}}> Golpe Furtivo · +1 dado de arma</label>{{/if}}
       {{#if codex.prepare.potionAvailable}}<label class="codex-check"><input type="checkbox" data-roll-option="potionResearch" {{#if codex.prepare.potionResearch}}checked{{/if}}> Criar poção · Pesquisa Avançada (+1 Êxito)</label>{{/if}}
       {{#if codex.prepare.asuraAvailable}}
       <label>Punho Supremo de Asura<select data-roll-option="asuraDieId">
        <option value="">Sem Asura</option>
        {{#each codex.prepare.asuraOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}} → d20</option>{{/each}}
       </select><small>5 esferas e 1 Coragem ao finalizar.</small></label>
       {{/if}}
       {{#if codex.prepare.inCombat}}{{#if codex.isHostile}}{{#unless codex.isAnimal}}
        <label>Custo local<select data-roll-option="activationPavor">
          {{#each codex.prepare.localCostOptions}}<option value="{{cost}}" {{#if selected}}selected{{/if}}>{{cost}}P local no total</option>{{/each}}
        </select></label>
        {{/unless}}{{/if}}{{/if}}
        {{#unless codex.prepare.hasTarget}}<label>DE manual<input type="number" min="0" max="30" value="{{codex.prepare.de}}" data-roll-option="de"></label>{{/unless}}
        <label>Condição<select data-roll-option="situation">{{#each codex.prepare.situations}}
          <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
        {{/each}}</select></label>
      </div>
      <details class="codex-roll-advanced" data-sync="roll-advanced"><summary>Opções avançadas</summary>
      <div class="codex-prep-controls">
        {{#if codex.prepare.offensive}}{{#if codex.prepare.hasTarget}}<label class="codex-check"><input type="checkbox" data-roll-option="manualDamage" {{#if codex.prepare.manualDamage}}checked{{/if}}> Resolver dano e proteções na mesa</label>{{/if}}{{/if}}
        {{#if codex.isMonster}}
        <label>Dados extras mantidos — 1P cada<select data-roll-option="extraKeep">
          <option value="0" {{#if codex.prepare.extraZero}}selected{{/if}}>0 (2 dados)</option>
          <option value="1" {{#if codex.prepare.extraOne}}selected{{/if}}>+1 (3 dados, se habilitado)</option>
          <option value="2" {{#if codex.prepare.extraTwo}}selected{{/if}}>+2 (4 dados, Graus 2–6)</option>
        </select></label>
        {{else}}
        {{#unless codex.isAnimal}}<label class="codex-check"><input type="checkbox" data-roll-option="extraKeep" {{#if codex.prepare.extraKeep}}checked{{/if}}> Manter +1 dado por 1 Coragem</label>{{/unless}}
        {{/if}}
        {{#unless codex.isAnimal}}
         <label class="codex-check"><input type="checkbox" data-roll-option="step" {{#if codex.prepare.step}}checked{{/if}}> Elevar um dado da pilha por 1 Coragem</label>
         {{#if codex.prepare.step}}
         <label>Escolha o dado<select data-roll-option="stepDieId">
           <option value="">Selecione um dado para subir uma categoria</option>
           {{#each codex.prepare.stepOptions}}<option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
         </select></label>
         {{/if}}
         {{/unless}}
        {{#if codex.prepare.hasCombatSkill}}<label class="codex-check"><input type="checkbox" data-roll-option="combatBonus" {{#if codex.prepare.combatBonus}}checked{{/if}}> Perícia Combate: +1A (se pertinente)</label>{{/if}}
        {{#unless codex.prepare.fixedSources}}<label class="codex-check"><input type="checkbox" data-roll-option="weightEnabled" {{#if codex.prepare.weightEnabled}}checked{{/if}}> Aplicar afinidade de peso e balanço (somente se pertinente)</label>{{/unless}}
        {{#if codex.prepare.weightEnabled}}
          <label>Peso do ataque<select data-roll-option="attackWeight">
            <option value="leve" {{#if codex.prepare.attackWeightLeve}}selected{{/if}}>Leve</option>
            <option value="medio" {{#if codex.prepare.attackWeightMedio}}selected{{/if}}>Médio</option>
            <option value="pesado" {{#if codex.prepare.attackWeightPesado}}selected{{/if}}>Pesado</option>
          </select></label>
          <label>Balanço do alvo<select data-roll-option="targetWeight">
            <option value="leve" {{#if codex.prepare.targetWeightLeve}}selected{{/if}}>Leve</option>
            <option value="medio" {{#if codex.prepare.targetWeightMedio}}selected{{/if}}>Médio</option>
            <option value="pesado" {{#if codex.prepare.targetWeightPesado}}selected{{/if}}>Pesado</option>
          </select></label>
        {{/if}}
      </div>
      </details>
      {{#if codex.prepare.canRepeatDisc}}<div class="codex-actions"><button type="button" data-action="repeatDiscipline" aria-pressed="{{#if codex.prepare.repeatedDiscipline}}true{{else}}false{{/if}}">{{#if codex.prepare.repeatedDiscipline}}Retirar segunda Disciplina{{else}}Adicionar segunda Disciplina{{/if}}</button></div>{{/if}}
      <div class="codex-pool"><strong>Pilha prevista · {{codex.prepare.poolCount}}/9 dados</strong>
        {{#each codex.prepare.pool}}<span class="codex-pool-die">{{{this.icon}}} <b>d{{this.sides}}</b><small>{{this.label}}</small></span>{{/each}}
      </div>
      <p class="codex-tip">Retenção natural: {{codex.prepare.keepNatural}}.</p>
      {{#each codex.prepare.errors}}<p class="codex-error">{{this}}</p>{{/each}}
      <div class="codex-actions"><button type="button" data-action="clearDraft">Cancelar preparação</button><button type="button" class="codex-primary" data-action="executeRoll" {{#unless codex.prepare.canExecute}}disabled{{/unless}}>Rolar dados</button></div>
    </section>
  {{/if}}

  {{#if codex.hasPending}}
    {{#if codex.pending.publishing}}
<section class="codex-block codex-roll-results"><p>A ação já foi confirmada. Retome o envio do resultado ao chat.</p><button type="button" data-action="finalizeRoll" {{#unless codex.pending.canFinalize}}disabled{{/unless}}>Retomar publicação</button></section>
    {{else}}
    <section class="codex-block codex-roll-results" aria-label="Dados rolados e escolha dos mantidos">
      <div class="codex-block-title"><h2>Resultado dos dados — escolha os mantidos</h2><span>Rolagem pendente preservada no personagem</span></div>
      <p class="codex-tip">{{codex.pending.selectedCount}} / {{codex.pending.limit}} mantidos · na confirmação: {{codex.pending.courageCost}} Coragem e {{codex.pending.localCost}}P local, antes de técnicas.</p>
      <div class="codex-result-dice">
      {{#each codex.pending.dice}}
        <button type="button" class="codex-result-die {{#if this.selected}}is-kept{{/if}}" data-action="toggleKept" data-id="{{this.id}}" aria-pressed="{{#if this.selected}}true{{else}}false{{/if}}">
          <span class="codex-result-die-head"><span>d{{this.sides}} · {{this.label}}</span>{{#if this.selected}}<span class="codex-kept-tag">MANTIDO</span>{{else}}<span class="codex-kept-tag">SELECIONAR</span>{{/if}}</span>
           <span class="codex-result-face codex-face-icons" role="img" aria-label="{{this.symbolsText}} · face {{this.face}}{{#if this.maximum}} · máxima{{/if}}">{{{this.symbolsHTML}}}</span>
            <span class="codex-result-symbols">{{#if this.selected}}Clique para retirar{{else}}Clique para manter{{/if}}</span>
        </button>
      {{/each}}
      </div>
      <div class="codex-prep-controls">
        {{#if codex.pending.hasProperties}}
        <label>Característica ativada<select data-pending-option="characteristic">
         <option value="">Nenhuma</option>{{#each codex.pending.properties}}
          <option value="{{this.name}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
         {{/each}}
        </select></label>
        <label>Segunda característica (somente em crítico)<select data-pending-option="secondCharacteristic">
         <option value="">Nenhuma</option>{{#each codex.pending.properties}}
          <option value="{{this.name}}" {{#if this.selectedSecond}}selected{{/if}}>{{this.name}}</option>
         {{/each}}
        </select></label>
        <label>Pagamento da característica paga<select data-pending-option="activationPayment">
         <option value="courage" {{#if codex.pending.paymentCourage}}selected{{/if}}>1 Coragem (custo-base de ativação)</option>

        </select></label>
        {{/if}}
        {{#if codex.pending.hasTarget}}<p>Alvo travado: <strong>{{codex.pending.targetName}}</strong>.</p>{{/if}}
        <label>Anular Pavor (1A por 1P)<input type="number" data-pending-option="cancelP" min="0" value="{{codex.pending.cancelP}}"></label>
        {{#if codex.pending.targetOptions.length}}
        <label>Passar a oportunidade (1A)<select data-pending-option="passAllyId">
          <option value="">Manter oportunidade</option>
          {{#each codex.pending.targetOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
        </select></label>
        {{/if}}
        <label>Converter Antecipar (2A → 1E)<input type="number" data-pending-option="convertPairs" min="0" value="{{codex.pending.convertPairs}}"></label>
      </div>
      {{#if codex.pending.summary}}
        {{#if codex.pending.summary.ok}}
          <div class="codex-outcome"><strong>{{codex.pending.summary.outcome}}</strong>{{#if codex.pending.critical}}<span><strong>Crítico automático — {{codex.pending.critical}} dados máximos</strong></span>{{/if}}<span>Total: {{codex.pending.summary.reached}} · DE: {{codex.pending.de}}</span><span><b class="codex-rune codex-rune-e">ᛋ {{codex.pending.summary.e}}</b> · <b class="codex-rune codex-rune-a">ᚨ {{codex.pending.summary.aRemaining}}</b> · <b class="codex-rune codex-rune-p">ᚦ {{codex.pending.summary.p}}</b></span><span>Dano básico: {{codex.pending.summary.damage}}</span></div>
        {{/if}}
      {{/if}}
      <details data-sync="comparisons" class="codex-compare-rolls">
       <summary>Comparar escolhas de dados mantidos (sem rolar novamente)</summary>
       <p class="codex-tip">Resultados exatos das faces atuais, sem anulações ou conversões adicionais. Nenhuma alternativa é aplicada automaticamente; compare acerto, Pavor e dano. Você pode escolher uma delas sem rerrolar nem gastar recursos até finalizar.</p>
       <div class="codex-compare-grid">
       {{#each codex.comparisons}}
        <div class="codex-compare-option">
         <div><strong>Alternativa {{this.position}}</strong><span class="codex-dice-strip">{{#each this.keptDice}}<span class="codex-small-die">{{{this.icon}}}<b>d{{this.sides}}</b><span class="codex-face-icons">{{{this.symbolsHTML}}}</span></span>{{/each}}</span></div>
         <b>{{this.outcome}}</b>
         <span>Total {{this.reached}} · <em class="codex-rune-e">ᛋ {{this.e}}</em> · <em class="codex-rune-a">ᚨ {{this.a}}</em> · <em class="codex-rune-p">ᚦ {{this.p}}</em></span>
         <small>Dano básico {{this.damage}} {{#if this.critical}}· crítico {{this.critical}}{{/if}}</small>
         <button type="button" data-action="applyComparison" data-index="{{@index}}">Usar estes dados mantidos</button>
        </div>
       {{/each}}
       </div>
      </details>
      {{#each codex.pending.errors}}<p class="codex-error">{{this}}</p>{{/each}}
      <div class="codex-actions"><button type="button" data-action="discardRoll" {{#unless codex.isOwner}}disabled{{/unless}}>Descartar rolagem</button><button type="button" class="codex-primary" data-action="finalizeRoll" {{#unless codex.pending.canFinalize}}disabled{{/unless}}>Finalizar ação</button></div>
    </section>
    {{/if}}
  {{/if}}

  </div>
  </section>

  <section id="{{codex.appId}}-page-inventory" class="codex-block codex-equipment codex-inventory" data-sheet-panel="inventory" aria-label="Inventário" hidden>
    <header class="codex-inventory-heading">
      <div class="codex-inventory-title">
        <img src="systems/codex-rpg-foundry/assets/icons/codex/status-inventario.svg" alt="">
        <div><h2>Inventário</h2><p>Equipamentos, carga e Valor de Troca</p></div>
      </div>
      {{#if codex.editing}}<button type="button" data-action="addEquipment">+ Adicionar item</button>{{/if}}
    </header>

    <nav class="codex-inventory-tabs" aria-label="Áreas do Inventário">
      {{#each codex.inventoryPages}}
      <button type="button" data-action="inventoryPage" data-pane="{{id}}" aria-controls="{{@root.codex.appId}}-inventory-{{id}}"><span aria-hidden="true">{{icon}}</span> {{label}}</button>
      {{/each}}
    </nav>
    <section id="{{codex.appId}}-inventory-bag" data-inventory-panel="bag" aria-label="Mochila e equipamentos">
      <dl class="codex-stat-cards">
        <div><dt>Itens</dt><dd>{{codex.equipment.itemCount}}</dd></div>
        <div><dt>Equipados</dt><dd>{{codex.equipment.equippedCount}}</dd></div>
        <div><dt>Carga</dt><dd>{{codex.loadUsed}} / {{codex.capacity}} Alto</dd></div>
      </dl>
      <div class="codex-load-track {{#if codex.overloaded}}is-overloaded{{/if}}" role="progressbar" aria-label="Capacidade de carga" aria-valuemin="0" aria-valuemax="{{codex.capacity}}" aria-valuenow="{{codex.loadMeter}}" aria-valuetext="{{codex.loadUsed}} de {{codex.capacity}} Alto{{#if codex.overloaded}} · sobrecarga{{/if}}"><span style="width:{{codex.loadPercent}}%"></span></div>
      <p class="codex-inventory-caption">Balanço {{codex.balance}} · {{codex.loadFree}} Alto livres{{#if codex.overloaded}} · Sobrecarga{{/if}}</p>
      <div class="codex-inventory-surface">
      <h3>Mochila e equipamentos</h3>
      <details class="codex-repertoire-panel" data-sync="repertoire">
      <summary>Repertório de armas, focos e proteção</summary>
      <div class="codex-repertoire">
      {{#each codex.equipment.repertoire}}
        <article data-repertoire-id="{{this.id}}">
          <strong>{{{this.icon}}} {{this.name}}</strong>
          <small>{{this.weightName}} · {{this.propertiesText}}{{#if this.range}} · alcance {{this.range}} m{{/if}}</small>
          {{#if this.attack}}<span class="codex-small-die">{{{this.dieIcon}}} d{{this.die}} habilitável</span>
          <small>Perícia exigida · {{this.requiredSkill}}. {{#if this.enabledDie}}Habilitada · dado d{{this.enabledDie}}{{else}}Confira habilitação e equipamento ativo{{/if}}</small>
          {{#if @root.codex.canAttack}}<button type="button" data-action="prepareEquipment" data-id="{{this.id}}" {{#unless this.enabledDie}}disabled{{/unless}}>Preparar ação</button>{{/if}}{{/if}}
          {{#if this.armor}}<small>Proteção · Integridade {{this.integrity.value}} / {{this.integrity.max}} · {{this.defense}} DE</small>{{/if}}
          {{#if this.shield}}<small>Escudo · Integridade {{this.integrity.value}} / {{this.integrity.max}} · bloqueio pela ação própria</small>{{/if}}
          <small>{{#if this.equipped}}Equipado{{else}}Guardado{{/if}}</small>
        </article>
      {{else}}<p>Nenhuma arma, foco ou proteção no inventário.</p>{{/each}}
      </div>
      </details>
      <div class="codex-equipment-filters">
        <label>Tipo<select data-equipment-filter="family">{{#each codex.equipment.families}}<option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></label>
        <label>Peso<select data-equipment-filter="weight">{{#each codex.equipment.weights}}<option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></label>
      </div>
      {{#each codex.equipment.gear}}
        {{#if this.groupTitle}}<h3>{{this.groupTitle}}</h3>{{/if}}
        <details data-sync="equipment-{{this.id}}" class="codex-equipment-row">
          <summary><span class="codex-inventory-icon">{{{this.icon}}}</span><strong>{{this.name}}</strong><small>{{this.quantity}} × · {{this.weightName}} · {{this.weight}} Alto</small><span class="codex-item-state {{#if this.equipped}}is-equipped{{/if}}">{{#if this.equipped}}Equipado{{else}}Guardado{{/if}}</span></summary>
          <div class="codex-item-fields">
            <p>{{this.description}}</p>
            <label>Quantidade<input type="number" min="1" value="{{this.quantity}}" data-item-field="quantity" data-id="{{this.id}}"></label>
            <label>Equipado<input type="checkbox" {{#if this.equipped}}checked{{/if}} data-item-field="equipped" data-id="{{this.id}}"></label>
            {{#if this.canShortcut}}{{#if @root.codex.isOwner}}
              <button type="button" data-action="attackShortcut" data-id="{{this.id}}" data-enabled="{{#if this.hasShortcut}}false{{else}}true{{/if}}">{{#if this.hasShortcut}}Remover atalho{{else}}Criar atalho de ataque{{/if}}</button>
            {{/if}}{{/if}}
            <label>Integridade<input type="number" min="0" value="{{this.integrity.value}}" data-item-field="integrity.value" data-id="{{this.id}}"></label>
            <label>Integridade máxima<input type="number" min="0" value="{{this.integrity.max}}" data-item-field="integrity.max" data-id="{{this.id}}"></label>
            <label>Munição restante<input type="number" min="0" value="{{this.ammo.value}}" data-item-field="ammo.value" data-id="{{this.id}}"></label>
            <label>Munição máxima<input type="number" min="0" value="{{this.ammo.max}}" data-item-field="ammo.max" data-id="{{this.id}}"></label>
            <label>Propriedades<input value="{{this.propertiesText}}" data-item-field="properties" data-id="{{this.id}}"></label>
            <label>Equipamentos associados<input value="{{this.associatedEquipment}}" data-item-field="associatedEquipment" data-id="{{this.id}}"></label>
            {{#if this.shield}}
              <label>Arma cravada<select data-item-field="embeddedWeapon" data-id="{{this.id}}"><option value="">Nenhuma</option><option value="medio" {{#if this.embeddedMedium}}selected{{/if}}>Média</option><option value="pesado" {{#if this.embeddedHeavy}}selected{{/if}}>Pesada</option></select></label>
              <label>Êxitos mantidos do ataque<input data-cravar-hits type="number" min="1" value="1"></label>
              <button type="button" data-action="cravarEquipment" data-id="{{this.id}}">Aplicar Cravar</button>
            {{/if}}
            {{#if @root.codex.editing}}<button type="button" data-action="openEquipment" data-id="{{this.id}}">Editar item completo</button><button type="button" data-action="removeEquipment" data-id="{{this.id}}">Excluir item</button>{{/if}}
          </div>
        </details>
      {{else}}<p>Nenhum item corresponde aos filtros.</p>{{/each}}
      </div>
    </section>
    <section id="{{codex.appId}}-inventory-wallet" data-inventory-panel="wallet" aria-label="Bolsa e Valor de Troca" hidden>
      <div class="codex-inventory-surface">
        <div class="codex-wallet-head">
          <div><h3>Bolsa e Valor de Troca</h3><p>Recursos disponíveis para negociar e comprar.</p></div>
          <output>{{codex.equipment.balance}} VT</output>
        </div>
        <dl class="codex-stat-cards codex-wallet-resources">
          {{#each codex.equipment.resources}}
          <div><dt>{{name}}</dt><dd>{{quantity}}</dd></div>
          {{/each}}
        </dl>
      </div>
    </section>
    <section id="{{codex.appId}}-inventory-shop" data-inventory-panel="shop" aria-label="Mercado e compras" hidden>
      <div class="codex-inventory-surface">
        <div class="codex-wallet-head"><h3>Mercado e compras</h3><output>{{codex.equipment.balance}} VT</output></div>
        <div class="codex-equipment-filters">
          <label>Tipo<select data-equipment-filter="shopFamily">{{#each codex.equipment.shopFamilies}}<option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></label>
          <label>Peso<select data-equipment-filter="shopWeight">{{#each codex.equipment.shopWeights}}<option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></label>
        </div>
        {{#each codex.equipment.shop}}
          <details data-sync="shop-{{this.id}}" data-shop-row class="codex-equipment-row">
            <summary><span class="codex-inventory-icon">{{{this.icon}}}</span><strong>{{this.name}}</strong><small>{{this.family}} · {{this.weightName}}{{#if this.hasDie}} · d{{this.die}}{{/if}}</small><span class="codex-item-state">{{#if this.canBuy}}{{this.price}} VT{{else}}Consultar{{/if}}</span></summary>
            <div class="codex-item-fields">
              <p>{{this.description}}</p>
              <p>{{#if this.attack}}Uso condicionado à Perícia de manejo ou foco, Disciplina e Grau permitido.{{/if}}{{#if this.armor}}Proteção · Integridade {{this.integrity.max}} · {{this.defense}} DE{{/if}}</p>
              {{#if this.canBuy}}
                <label>Quantidade<input type="number" min="1" max="99" value="1" data-shop-quantity></label>
                <button type="button" data-action="buyEquipment" data-name="{{this.name}}" {{#unless this.canAfford}}disabled{{/unless}}>Comprar · {{this.price}} VT por unidade</button>
              {{else}}<p>Compra indisponível. Preço ou fabricação pendente.</p>{{/if}}
            </div>
          </details>
        {{else}}<p>Nenhum equipamento corresponde aos filtros.</p>{{/each}}
      </div>
    </section>
  </section>

  <details data-sync="notes" class="codex-block">
    <summary>Notas da ficha</summary>
    {{#if codex.isHostile}}
    <label>Capacidades <textarea data-field="system.abilities" {{#unless codex.editing}}readonly{{/unless}}>{{codex.abilities}}</textarea></label>
    <label class="codex-check"><input type="checkbox" data-field="system.leader" {{#if codex.leader}}checked{{/if}} {{#unless codex.editing}}disabled{{/unless}}> Liderança</label>
    {{/if}}
    <label>Notas <textarea data-field="system.notes" {{#unless codex.editing}}readonly{{/unless}}>{{codex.notes}}</textarea></label>
  </details>
</section>
