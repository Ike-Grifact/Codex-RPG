{{#*inline "sourceButton"}}
<button type="button" class="codex-source-pick" data-action="chooseSource" data-group="{{group}}" data-key="{{key}}" data-slot="{{slot}}" aria-pressed="{{#if picked}}true{{else}}false{{/if}}">
  <span>{{name}}</span><strong>{{dice}}</strong>
</button>
{{/inline}}
<section class="codex-foundry-root">
  <header class="codex-header">
    <img class="codex-portrait" src="{{codex.portrait}}" alt="">
    <div class="codex-brand-rune" aria-hidden="true">ᛋ <span>ᚨ</span> ᚦ</div>
    <div class="codex-identity">
      <small>{{codex.role}} {{#if codex.monster}}· G{{codex.s.threatGrade}}{{else}}· Nível {{codex.s.level}}{{/if}}</small>
      <h1>{{codex.name}}</h1>
      {{#if codex.s.concept}}<p>{{codex.s.concept}}</p>{{/if}}
    </div>
    <div class="codex-modes" role="group" aria-label="Modo da ficha">
      {{#each codex.modes}}<button type="button" data-action="selectMode" data-mode="{{key}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}" {{#if ../codex.hasPending}}disabled{{/if}}>{{label}}</button>{{/each}}
    </div>
  </header>
  <div class="codex-facts" aria-label="Recursos e defesa">
    {{#each codex.resources}}
    <div class="codex-resource">
      <span>{{label}}</span>
      <div>
        {{#if edit}}<button type="button" data-action="adjustResource" data-resource="{{path}}" data-delta="-1" aria-label="Diminuir {{label}}" {{#if ../codex.hasPending}}disabled{{/if}}>−</button>{{/if}}
        <strong>{{value}} / {{max}}</strong>
        {{#if edit}}<button type="button" data-action="adjustResource" data-resource="{{path}}" data-delta="1" aria-label="Aumentar {{label}}" {{#if ../codex.hasPending}}disabled{{/if}}>+</button>{{/if}}
      </div>
    </div>
    {{/each}}
    <div class="codex-resource"><span>DE</span><strong>{{codex.de}}</strong></div>
    <div class="codex-resource"><span>Carga</span><strong>{{codex.load}} / {{codex.capacity}} Alto</strong></div>
  </div>
  <nav class="codex-tabs" aria-label="Seções da ficha">
    {{#each codex.tabs}}<button type="button" data-action="selectTab" data-tab="{{key}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}">{{label}}</button>{{/each}}
  </nav>
  <div class="codex-scroll">

  {{#if codex.wizard}}
  <section class="codex-wizard">
    <header class="codex-wizard-intro">
      <small>CRIAÇÃO ASSISTIDA · APRENDIZ</small>
      <h2>Desenvolva seu <em>Codex Genético.</em></h2>
      <p>Uma escolha por vez. A ficha jogável aparece após a revisão; as regras e o orçamento são do Codex RPG.</p>
    </header>
    <nav class="codex-wizard-nav" aria-label="Etapas da criação">
      {{#each codex.wizardSteps}}
      <button type="button" data-action="wizardStep" data-step="{{index}}"
       aria-current="{{#if selected}}step{{else}}false{{/if}}" {{#unless available}}disabled{{/unless}}>
       <span>{{index}}</span><strong>{{name}}</strong><small>{{subtitle}}</small>
      </button>
      {{/each}}
    </nav>
    <div class="codex-wizard-layout">
      <div class="codex-wizard-stage">
        {{#if codex.wizardIdentity}}
        <span class="codex-wizard-kicker">01 · IDENTIDADE</span>
        <h2>Quem você quer ser?</h2>
        <p>Todo personagem começa como Aprendiz. O conceito não limita as profissões emergentes.</p>
        <div class="codex-controls">
          <label>Nome<input data-field="name" value="{{codex.name}}" placeholder="Nome do Aprendiz"></label>
          <label>Conceito / profissão<input data-field="system.concept" value="{{codex.s.concept}}" placeholder="Quem pretende se tornar?"></label>
          <label>Origem<input data-field="system.origin" value="{{codex.s.origin}}"></label>
          <label>Virtude<input data-field="system.virtue" value="{{codex.s.virtue}}"></label>
          <label>Personalidade<input data-field="system.personality" value="{{codex.s.personality}}"></label>
        </div>
        <label>História e notas<textarea data-field="system.notes" rows="4">{{codex.s.notes}}</textarea></label>
        {{/if}}
        {{#if codex.wizardGenetic}}
        <span class="codex-wizard-kicker">02 · CODEX GENÉTICO</span>
        <h2>Seu DNA, suas escolhas.</h2>
        <p>Desenvolva primeiro um <strong>Atributo</strong> na hélice central. Depois, escolha ao menos um <strong>Conhecimento ou Prática</strong> da órbita. As Perícias ficam azuis conforme o personagem atende aos requisitos. Distribua <strong>19 XP</strong> livremente, respeitando os custos dos Graus.</p>
        <div class="codex-gene-legend"><span class="owned">● Adquirido</span><span class="available">● Disponível para comprar</span><span class="locked">● Bloqueado ou futuro</span></div>
        <div class="codex-gene-layout">
          <div class="codex-gene-map" data-codex-gene aria-label="Grafo do Codex Genético: Atributos centrais, Conhecimentos e Práticas orbitais e Perícias"></div>
          <aside class="codex-gene-detail" aria-live="polite">
            {{#with codex.geneDetail}}
              <span class="codex-gene-state is-{{state}}">{{#if isSkill}}Perícia{{else}}Fonte do personagem{{/if}} · {{state}}</span>
              <h3>{{name}}</h3>
              {{#if isSkill}}
                <p>{{detail}}</p>
                <dl><dt>Requisitos</dt><dd>{{request}}</dd><dt>Custo</dt><dd>{{cost}} XP</dd></dl>
                {{#if owned}}<button type="button" data-action="toggleSkill" data-key="{{id}}">Reverter Perícia</button>
                {{else}}<button type="button" class="codex-primary" data-action="toggleSkill" data-key="{{id}}" {{#unless canBuy}}disabled{{/unless}}>Adquirir por {{cost}} XP</button>{{/if}}
              {{else}}
                <p>Grau {{grade}} · {{dice}}</p>
                <p>Próximo Grau: {{nextCost}} XP</p>
                <div class="codex-gene-buttons">
                  <button type="button" data-action="adjustGrade" data-group="{{sourceGroup}}" data-key="{{key}}" data-delta="-1" {{#unless canLower}}disabled{{/unless}}>− Grau</button>
                  <button type="button" class="codex-primary" data-action="adjustGrade" data-group="{{sourceGroup}}" data-key="{{key}}" data-delta="1" {{#unless canRaise}}disabled{{/unless}}>+ Grau · {{nextCost}} XP</button>
                </div>
              {{/if}}
            {{/with}}
            <small>As conexões são afinidades temáticas. O requisito válido é o descrito no verbete e verificado pelo sistema.</small>
          </aside>
        </div>
        {{/if}}
        {{#if codex.wizardReview}}
        <span class="codex-wizard-kicker">03 · REVISÃO FINAL</span><h2>Este é seu Aprendiz.</h2>
        <p>Confira o nome, os investimentos e o conjunto de Perícias adquiridas antes de concluir.</p>
        <div class="codex-wizard-review">
          <strong>{{codex.name}}</strong>
          <span>{{codex.s.concept}} · {{codex.s.origin}}</span>
          <p>Vida {{codex.s.life.value}} · DE {{codex.de}} · {{codex.ledger.spent}} XP investidos</p>
        </div>
        <h3>Suas Perícias</h3>
        <div class="codex-owned-list">
        {{#each codex.ownedSkills}}<div><strong>{{name}}</strong><small>{{detail}}</small></div>
        {{else}}<p>Nenhuma Perícia comprada.</p>{{/each}}
        </div>
        {{/if}}
      </div>
      <aside class="codex-wizard-sidebar">
        <small>IDENTIDADE EM FORMAÇÃO</small>
        <h3>{{codex.name}}</h3><p>{{codex.s.concept}}</p>
        <div class="codex-wizard-xp"><span>XP gasto</span><strong>{{codex.ledger.spent}} / {{codex.ledger.grant}}</strong></div>
        <div class="codex-wizard-budget"><span>Atributos</span><b>{{codex.ledger.attributes}} XP</b></div>
        <div class="codex-wizard-budget"><span>Formação</span><b>{{codex.ledger.training}} XP</b></div>
        <div class="codex-wizard-budget"><span>Perícias</span><b>{{codex.ledger.skills}} XP</b></div>
        <div class="codex-wizard-budget"><span>Saldo disponível</span><b>{{codex.ledger.left}} XP</b></div>
        <p class="codex-note">Orçamento inicial DEFINIDO: 19 XP compartilhados, sem cotas por categoria. O criador exige um Atributo e um Conhecimento ou Prática de Grau 1.</p>
      </aside>
    </div>
    <footer class="codex-wizard-footer">
      {{#each codex.wizardSteps}}
        {{#if prev}}<button type="button" data-action="wizardStep" data-step="{{index}}">← Voltar</button>{{/if}}
      {{/each}}
      {{#if codex.wizardLast}}
        <button type="button" class="codex-primary" data-action="finishCreation" {{#unless codex.wizardCanFinish}}disabled{{/unless}}>Concluir e abrir ficha →</button>
      {{else}}
        {{#each codex.wizardSteps}}{{#if next}}<button type="button" class="codex-primary" data-action="wizardStep" data-step="{{index}}">Continuar →</button>{{/if}}{{/each}}
      {{/if}}
    </footer>
  </section>
  {{else}}
  {{#if codex.showBattle}}
    <section class="codex-action" aria-label="Rolagem">
      {{#if codex.result}}
        {{#with codex.result}}
        <div class="codex-section-title"><h2>Dados rolados</h2><span>{{count}} / {{limit}} mantidos</span></div>
        {{#if publishing}}
          <p>A ação foi confirmada. Retome a publicação no chat.</p>
        {{else}}
          <div class="codex-result-dice">
          {{#each dice}}
            <button type="button" class="codex-result-die {{#if maximal}}codex-max-face{{/if}}" data-action="toggleKept" data-id="{{id}}" aria-pressed="{{#if kept}}true{{else}}false{{/if}}" {{#unless @root.codex.owner}}disabled{{/unless}}>
              <span class="codex-face">{{{icon}}}<strong>{{face}}</strong></span>
              <span class="codex-symbols" aria-label="{{text}}">{{{runes}}}</span>
              <small>d{{sides}} · {{label}}</small>
            </button>
          {{/each}}
          </div>
          {{#if summary}}
            <div class="codex-controls">
              <label>Anular Pavor · 1A por 1P<input type="number" data-pending-option="cancelP" min="0" max="{{summary.pAvailable}}" value="{{cancelP}}"></label>
              <label>Converter · 2A por 1E<input type="number" data-pending-option="convertPairs" min="0" value="{{convertPairs}}"></label>
              {{#if allies.length}}
                <label>Aliado para passagem<select data-pending-option="allyId">
                  <option value="">Escolha o aliado</option>
                  {{#each allies}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                </select></label>
                <label class="codex-check"><input type="checkbox" data-pending-option="passA" {{#if passA}}checked{{/if}}> Reservar 1A para passar ao aliado</label>
              {{/if}}
              {{#if hasProperties}}
                <label>Característica {{#if summary.critical}}gratuita{{else}}paga{{/if}}<select data-pending-option="characteristic">
                  <option value="">Nenhuma</option>
                  {{#each properties}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                </select></label>
                {{#if second}}
                <label>Segunda característica · paga<select data-pending-option="secondCharacteristic">
                  <option value="">Nenhuma</option>
                  {{#each secondProperties}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                </select></label>
                {{/if}}
                {{#if paid}}
                <label>Pagamento<select data-pending-option="activationPayment">
                  {{#each payment}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                </select></label>
                {{/if}}
              {{/if}}
            </div>
            <div class="codex-outcome" aria-live="polite">
              <strong>{{summary.outcome}}</strong>
              {{#if summary.critical}}<span>Crítico · {{summary.critical}} faces máximas</span>{{/if}}
              <span><b class="codex-rune-e">ᛋ {{summary.e}}</b> · <b class="codex-rune-a">ᚨ {{summary.aRemaining}}</b> · <b class="codex-rune-p">ᚦ {{summary.p}}</b></span>
              {{#if hasDE}}<span>E + P {{summary.reached}} / DE {{de}} {{target}}</span>{{/if}}
              {{#if summary.cost}}<span>Custo {{summary.cost}} {{resource}}</span>{{/if}}
              {{#each summary.errors}}<span class="codex-error">{{this}}</span>{{/each}}
            </div>
          {{else}}
          <p>Escolha os dados mantidos. Os descartados ficam fora do resultado.</p>
          {{/if}}
        {{/if}}
        <div class="codex-actions"><button type="button" class="codex-primary" data-action="finalizeRoll" {{#unless canFinish}}disabled{{/unless}}>Publicar no chat</button></div>
        {{/with}}
      {{else}}
        <div class="codex-section-title"><h2>{{codex.base}} {{#if codex.attribute}}+ {{codex.attribute}}{{/if}}</h2>
          <button type="button" data-action="clearDraft">Cancelar</button>
        </div>
        {{#if codex.pickAttribute}}
        <div class="codex-attribute-pick" role="group" aria-label="Escolher Atributo pertinente">
          {{#each codex.attributeGroup.sources}}{{> sourceButton slot="attribute"}}{{/each}}
        </div>
        {{/if}}
        {{#with codex.prepare}}
        <div class="codex-controls">
          {{#if modes}}
          <label>Ação<select data-option="mode">
            {{#each modes}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select></label>
          {{/if}}
          {{#if showGear}}
            <label>{{#if isMagic}}Foco ou magia{{else}}Arma equipada{{/if}}<select data-option="equipmentId">
              <option value="">{{#if isMagic}}Selecione{{else}}Sem arma{{/if}}</option>
              {{#each gear}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
            </select></label>
          {{/if}}
          {{#if showDual}}<label class="codex-check"><input type="checkbox" data-option="dual" {{#if dual}}checked{{/if}}> Manejo Duplo</label>{{/if}}
          <label>Situação<select data-option="situation">
            {{#each condition}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select></label>
          {{#if target}}<div class="codex-target"><small>Alvo · {{target}}</small><strong>DE {{targetDE}}</strong></div>
          {{else}}<label>DE manual · opcional<input data-option="de" type="number" min="0" max="30" value="{{manualDE}}" placeholder="Sem DE"></label>{{/if}}
          <label>Retenção<select data-option="extraKeep">
            {{#each extra}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select></label>
          {{#unless @root.codex.pavor}}<label class="codex-check"><input type="checkbox" data-option="step" {{#if step}}checked{{/if}}> Elevar um dado de Atributo · 1 Coragem</label>{{/unless}}
          {{#if @root.codex.complementAllowed}}
          <label>Complemento<select data-option="complement">
            <option value="">Nenhum</option>
            {{#each @root.codex.eligibleComplements}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
          </select></label>
          {{#if complement}}<label class="codex-check"><input type="checkbox" data-option="contextApproved" {{#if contextApproved}}checked{{/if}}> Pertinência confirmada pelo Narrador</label>{{/if}}
          {{/if}}
        </div>
        {{#each warnings}}<p class="codex-note">{{this}}</p>{{/each}}
        {{#each errors}}<p class="codex-error" role="status">{{this}}</p>{{/each}}
        <div class="codex-pool">
          <strong>{{count}} / 9 dados</strong>
          {{#each pool}}<span class="codex-pool-die" title="{{label}}">{{{icon}}}<b>d{{sides}}</b><small>{{label}}</small></span>{{/each}}
        </div>
        <div class="codex-actions">
          {{#if cost}}<span>Custo previsto {{cost}} {{resource}}</span>{{/if}}
          <button type="button" class="codex-primary" data-action="executeRoll" {{#unless canRoll}}disabled{{/unless}}>Rolar</button>
        </div>
        {{/with}}
      {{/if}}
    </section>
  {{/if}}
  {{#if codex.overview}}
    {{#if codex.editing}}
    <section class="codex-section"><h2>Identidade</h2>
      <div class="codex-controls">
        <label>Nome<input data-field="name" value="{{codex.name}}"></label>
        <label>Conceito<input data-field="system.concept" value="{{codex.s.concept}}"></label>
        <label>Origem<input data-field="system.origin" value="{{codex.s.origin}}"></label>
        <label>Virtude<input data-field="system.virtue" value="{{codex.s.virtue}}"></label>
        <label>Personalidade<input data-field="system.personality" value="{{codex.s.personality}}"></label>
      </div>
      <label>Notas<textarea data-field="system.notes" rows="4">{{codex.s.notes}}</textarea></label>
    </section>
    {{else}}
    <section class="codex-section">
      <h2>Escolha a fonte da ação</h2>
      {{#if codex.owner}}
      <div class="codex-sources">
        {{#each codex.sourceGroups}}
        <div><h3>{{title}}</h3>
        {{#each sources}}{{> sourceButton slot="base"}}{{/each}}</div>
        {{/each}}
      </div>
      {{/if}}
    </section>

    <section class="codex-section codex-owned-showcase">
      <div class="codex-section-title"><h2>Seu repertório</h2><span>Somente habilidades adquiridas</span></div>
      <div class="codex-owned-columns">
        <div class="codex-owned-col"><h3>Perícias em jogo</h3><div class="codex-owned-list">
        {{#each codex.ownedSkills}}<article class="codex-owned-card"><strong>{{name}}</strong><small>{{detail}}</small></article>
        {{else}}<p>Você ainda não adquiriu Perícias. Abra a página Perícias para evoluir.</p>{{/each}}</div></div>
        <div class="codex-owned-col"><h3>Elementos</h3><div class="codex-element-chips">
         {{#each codex.ownedElements}}<span class="codex-element-chip">ᚨ {{name}}</span>
         {{else}}<p>Nenhum elemento adquirido.</p>{{/each}}</div>
         <h3>Equipamentos ativos</h3><div class="codex-owned-list">
         {{#each codex.equippedGear}}<article class="codex-owned-card"><strong>{{name}} <small>{{die}}</small></strong><small>{{summary}}</small></article>
         {{else}}<p>Nenhum equipamento ativo.</p>{{/each}}</div>
        </div>
      </div>
    </section>
    {{#if codex.s.notes}}<section class="codex-section"><h2>Notas</h2><p class="codex-notes">{{codex.s.notes}}</p></section>{{/if}}
    {{/if}}
  {{/if}}
  {{#if codex.training}}
    <section class="codex-section codex-xp">
      <div class="codex-section-title"><h2>Experiência</h2><strong>{{codex.ledger.left}} XP disponíveis</strong></div>
      <p>{{codex.ledger.attributes}} em Atributos · {{codex.ledger.training}} em Formação · {{codex.ledger.skills}} em Perícias{{#if codex.ledger.retired}} · {{codex.ledger.retired}} sem reembolso{{/if}}</p>
      {{#if codex.monster}}<p>PENDENTE · orçamento por Grau. O Narrador informa o XP disponível.</p>
      {{else}}<p>Criação · 6 Atributos / 8 Formação (experimental) · 5 Perícias · XP de campanha livre.</p>{{/if}}
      {{#if codex.admin}}
      <div class="codex-controls">
        <label>XP de campanha / orçamento<input type="number" min="0" data-field="system.xp" value="{{codex.s.xp}}"></label>
        {{#if codex.pavor}}<label>Grau da ameaça<input type="number" min="1" max="6" data-field="system.threatGrade" value="{{codex.s.threatGrade}}"></label>{{/if}}
        {{#unless codex.monster}}<label>Nível<input type="number" min="1" max="20" data-field="system.level" value="{{codex.s.level}}"></label>{{/unless}}
        {{#if codex.humanoid}}<label class="codex-check"><input type="checkbox" data-field="system.opposition" {{#if codex.s.opposition}}checked{{/if}}> Usar recursos da oposição</label>{{/if}}
        <label class="codex-check"><input type="checkbox" data-field="system.creationOpen" {{#if codex.creation}}checked{{/if}}> Criação aberta · reversões devolvem XP</label>
      </div>
      {{/if}}
    </section>
    {{#each codex.groups}}
      <section class="codex-section">
        <h2>{{title}}</h2>
        <div class="codex-grade-grid">
        {{#each sources}}
          <div class="codex-grade"><span><strong>{{name}}</strong><small>Grau {{grade}} · {{dice}}</small></span>
          {{#if @root.codex.editing}}
          <div>
            {{#if @root.codex.canReverse}}<button type="button" data-action="adjustGrade" data-group="{{group}}" data-key="{{key}}" data-delta="-1" aria-label="Reverter grau de {{name}}" {{#unless grade}}disabled{{/unless}}>−</button>{{/if}}
            {{#if nextCost}}<button type="button" data-action="adjustGrade" data-group="{{group}}" data-key="{{key}}" data-delta="1" aria-label="Comprar grau de {{name}} por {{nextCost}} XP">+ {{nextCost}} XP</button>{{/if}}
          </div>
          {{/if}}
          </div>
        {{/each}}
        </div>
      </section>
    {{/each}}
  {{/if}}
  {{#if codex.skillsPage}}
    {{#unless codex.monster}}
    <section class="codex-section"><div class="codex-section-title"><h2>Catálogo de Perícias</h2><span>Compre e consulte fora da ficha de combate</span></div>
      <label>Buscar Perícia<input type="search" data-skill-search value="{{codex.skillSearch}}" placeholder="Nome, efeito ou requisito"></label>
      <div class="codex-skills-list">
      {{#each codex.skills}}
      <div class="codex-skill">
        <details><summary>{{name}} · {{cost}} XP{{#if owned}} · adquirida{{/if}}</summary><p>{{detail}}</p></details>
        <small>{{request.label}}</small>
        {{#if @root.codex.editing}}
          {{#if owned}}
            {{#if @root.codex.canReverse}}<button type="button" data-action="toggleSkill" data-key="{{id}}">Reverter</button>{{/if}}
          {{else}}
            <button type="button" data-action="toggleSkill" data-key="{{id}}" {{#unless canBuy}}{{#unless @root.codex.admin}}disabled{{/unless}}{{/unless}}>Adquirir</button>
          {{/if}}
        {{/if}}
      </div>
      {{/each}}
      </div>
    </section>
    {{/unless}}
  {{/if}}
  {{#if codex.inventory}}
    <section class="codex-section">
      <h2>Defesa</h2>
      <label>Resposta defensiva<select data-field="system.defense" {{#unless codex.owner}}disabled{{/unless}}>
        {{#each codex.defense}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select></label>
      <p>Balanço {{codex.balance}} · DE efetiva {{codex.de}}</p>
    </section>
    <section class="codex-section">
      <h2>Equipamento</h2>
      {{#each codex.gear}}
      <div class="codex-gear">
        <div><button type="button" class="codex-gear-name" data-action="openEquipment" data-id="{{id}}">{{name}}</button>
        <small>Grau {{grade}} · {{quantity}} un. · {{weight}} Alto/un. · {{priceVT}} VT · Integridade {{integrity.value}}/{{integrity.max}}</small></div>
        {{#if @root.codex.owner}}
          <button type="button" data-action="toggleEquip" data-id="{{id}}" aria-pressed="{{#if equipped}}true{{else}}false{{/if}}" {{#if @root.codex.hasPending}}disabled{{/if}}>{{#if equipped}}Desequipar{{else}}Equipar{{/if}}</button>
          {{#if @root.codex.editing}}<button type="button" data-action="removeEquipment" data-id="{{id}}" aria-label="Excluir {{name}}">Excluir</button>{{/if}}
        {{/if}}
      </div>
      {{else}}<p>Inventário vazio.</p>{{/each}}
      {{#if codex.owner}}<div class="codex-catalog-picker">
        <label>Catálogo G1 · valores de playtest<select data-catalog-choice>
          {{#each codex.catalog}}<option value="{{id}}">{{name}}</option>{{/each}}
