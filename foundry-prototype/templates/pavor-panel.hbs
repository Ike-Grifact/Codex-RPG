<section class="codex-pavor-hud" aria-label="Reserva pública de Pavor">
  <div class="codex-pavor-group" role="group" aria-label="Jogadores na campanha">
    <button type="button" data-action="adjustPlayers" data-delta="-1" title="Retirar um jogador" aria-label="Retirar um jogador" {{#unless canRemovePlayer}}disabled{{/unless}}>−</button>
    <span class="codex-pavor-label" title="{{#if automatic}}Contagem do cadastro{{else}}Contagem manual; clique para voltar ao cadastro{{/if}}">
      {{#if automatic}}
        <i class="fa-solid fa-users" aria-hidden="true"></i>
        <strong aria-live="polite">{{players}} <span class="codex-pavor-sr">jogadores</span></strong>
      {{else}}
        <button type="button" class="codex-pavor-player-count" data-action="useRegisteredPlayers" aria-label="{{players}} jogadores. Voltar à contagem do cadastro">
          <i class="fa-solid fa-users" aria-hidden="true"></i> {{players}}
        </button>
      {{/if}}
    </span>
    <button type="button" data-action="adjustPlayers" data-delta="1" title="Adicionar um jogador" aria-label="Adicionar um jogador" {{#unless canAddPlayer}}disabled{{/unless}}>+</button>
  </div>
  <div class="codex-pavor-group" role="group" aria-label="Ajustar Pavor público">
    <button type="button" data-action="adjust" data-delta="-1" title="Retirar 1 Pavor" aria-label="Retirar 1 Pavor" {{#unless canRemoveOne}}disabled{{/unless}}>−</button>
    <span class="codex-pavor-runes" aria-hidden="true" title="{{value}} de {{cap}} Pavor na reserva">
      {{#each slots}}<span class="codex-pavor-slot {{#if filled}}is-filled{{/if}}">ᚦ</span>{{/each}}
      {{#if overflow}}<small>+{{overflow}}</small>{{/if}}
    </span>
    <strong class="codex-pavor-balance" aria-live="polite" title="Pavor público · saldo / teto">{{value}}/{{cap}}<span class="codex-pavor-sr"> Pavor público</span></strong>
    <button type="button" data-action="adjust" data-delta="1" title="Adicionar 1 Pavor" aria-label="Adicionar 1 Pavor" {{#unless canAddOne}}disabled{{/unless}}>+</button>
  </div>
  {{#if round}}
    <span class="codex-pavor-round" title="Pavor que entrou na reserva pública nesta rodada" aria-live="polite">R{{round}} <strong>+{{roundPavor}}P</strong><span class="codex-pavor-sr"> adicionados à reserva nesta rodada</span></span>
  {{/if}}
</section>
